+    /// （計測専用。tsuitate-nn の rnad/proto/speed2）生きている局の手番について、observe の部品を1スレッドで順に呼んだ合計の秒:
+    /// [referee.view, candidate_usis, deduced_facts, legal_mask, encode_into(v1 = 86枚), observe_into(v2・差分キャッシュ込み)]
+    fn bench_parts(&mut self) -> Vec<f64> {
+        use std::time::Instant;
+        use tsuitate_bot::rl::action::{candidate_usis, deduced_facts, legal_mask};
+        use tsuitate_bot::rl::encode::encode_into;
+        let mut t = vec![0.0f64; 6];
+        let mut buf1 = vec![0.0f32; OBS_LEN];
+        let mut buf2 = vec![0.0f32; self.planes * 81];
+        for g in self.games.iter_mut().filter(|g| g.outcome().is_none()) {
+            let r = g.referee();
+            let side = r.to_move();
+            let s = Instant::now();
+            let view = r.view(side, [300_000, 300_000], g.game_no());
+            t[0] += s.elapsed().as_secs_f64();
+            let s = Instant::now();
+            let c = candidate_usis(&view);
+            t[1] += s.elapsed().as_secs_f64();
+            std::hint::black_box(&c);
+            let s = Instant::now();
+            let f = deduced_facts(&view, r.log(side), r.foul_tried(side));
+            t[2] += s.elapsed().as_secs_f64();
+            std::hint::black_box(&f.occupied);
+            let s = Instant::now();
+            let m = legal_mask(&view, r.log(side), r.foul_tried(side));
+            t[3] += s.elapsed().as_secs_f64();
+            std::hint::black_box(&m);
+            let s = Instant::now();
+            encode_into(&view, r.log(side), r.foul_tried(side), &mut buf1);
+            t[4] += s.elapsed().as_secs_f64();
+            let s = Instant::now();
+            g.observe_into(&mut buf2);
+            t[5] += s.elapsed().as_secs_f64();
+        }
+        t
+    }
+
+    /// （試作。docs/rl-learning-speed.md の S1(b)）生きている局だけの (観測, マスク, 手番の色)。
+    /// 並びは局の添字の昇順 = `observe()` の obs[alive] と同じ。終局した局の観測を作らない
+    fn observe_alive<'py>(&mut self, py: Python<'py>) -> PyResult<ObserveOut<'py>> {
+        let planes = self.planes;
+        let len = planes * 81;
+        let mut live: Vec<&mut EnvGame> = self.games.iter_mut().filter(|g| g.outcome().is_none()).collect();
+        let n = live.len();
+        let player: Vec<i8> = live.iter().map(|g| color_code(g.to_move())).collect();
+        let (obs, mask) = py.detach(|| {
+            let mut obs = vec![0.0f32; n * len];
+            let mut mask = vec![false; n * NUM_ACTIONS];
+            obs.par_chunks_mut(len)
+                .zip(mask.par_chunks_mut(NUM_ACTIONS))
+                .zip(live.par_iter_mut())
+                .for_each(|((o, m), g)| {
+                    g.observe_into(o);
+                    m.copy_from_slice(g.mask());
+                });
+            (obs, mask)
+        });
+        Ok((
+            PyArray1::from_vec(py, obs).reshape([n, planes, 9, 9])?,
+            PyArray1::from_vec(py, mask).reshape([n, NUM_ACTIONS])?,
+            PyArray1::from_vec(py, player),
+        ))
+    }
+
+    /// （試作。docs/rl-learning-speed.md の S1(b)）生きている局だけの
+    /// (観測の fp16 のビット [n, planes*81] u16, 合法手の添字 i16, 行ごとの個数 i32, 手番の色)。
+    /// fp16 への丸めは torch の `.half()` と同じ最近接偶数、添字は行ごとに昇順（`np.nonzero(mask[alive])[1]` と同じ）
+    fn observe_alive_f16_csr<'py>(
+        &mut self,
+        py: Python<'py>,
+    ) -> PyResult<(
+        Bound<'py, PyArray2<u16>>,
+        Bound<'py, PyArray1<i16>>,
+        Bound<'py, PyArray1<i32>>,
+        Bound<'py, PyArray1<i8>>,
+    )> {
+        let planes = self.planes;
+        let len = planes * 81;
+        let mut live: Vec<&mut EnvGame> = self.games.iter_mut().filter(|g| g.outcome().is_none()).collect();
+        let n = live.len();
+        let player: Vec<i8> = live.iter().map(|g| color_code(g.to_move())).collect();
+        let (obs16, cols, counts) = py.detach(|| {
+            let mut obs16 = vec![0u16; n * len];
+            let per: Vec<Vec<i16>> = obs16
+                .par_chunks_mut(len)
+                .zip(live.par_iter_mut())
+                .map_init(
+                    || vec![0.0f32; len],
+                    |buf, (o, g)| {
+                        g.observe_into(buf);
+                        for (d, &s) in o.iter_mut().zip(buf.iter()) {
+                            *d = f32_to_f16(s);
+                        }
+                        g.mask()
+                            .iter()
+                            .enumerate()
+                            .filter(|&(_, &m)| m)
+                            .map(|(i, _)| i as i16)
+                            .collect()
+                    },
+                )
+                .collect();
+            let counts: Vec<i32> = per.iter().map(|v| v.len() as i32).collect();
+            let cols: Vec<i16> = per.concat();
+            (obs16, cols, counts)
+        });
+        Ok((
+            PyArray1::from_vec(py, obs16).reshape([n, len])?,
+            PyArray1::from_vec(py, cols),
+            PyArray1::from_vec(py, counts),
+            PyArray1::from_vec(py, player),
+        ))
+    }
 
