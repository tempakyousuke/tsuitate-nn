@@ -0,0 +1,74 @@
+"""α の補間の長さ（`RNaDConfig.schedule_ramp`）と段階の収束の見張り（kl_online_reg / kl_target_reg / kl_online_target）の検査。
+tsuitate_rl が要る。
+
+    .venv/bin/python rnad/tests/test_stage_ramp.py
+
+- schedule_ramp = 0 の α と差し替えの step は、参照の min(2n/size, 1) とビット単位で同じ（--schedule-start の列でも）
+- schedule_ramp = R なら段階の頭から R 更新で α = 1 に届き、ramp_len が --tail-avg の窓の始まりを返す
+- 見張りの3つは、4つのネットが同じ学習の頭では 0、更新が進むと有限で非負。古い checkpoint の設定（schedule_ramp が無い）
+  とは設定の差にならない
+"""
+
+import pathlib
+import sys
+
+import torch
+
+HERE = pathlib.Path(__file__).resolve().parent
+sys.path.insert(0, str(HERE.parent))
+import tsuitate_rl  # noqa: E402
+from model import PolicyValueNet  # noqa: E402
+from rnad import EntropySchedule, RNaDConfig, RNaDLearner, cfg_diff, collect  # noqa: E402
+
+DEV = torch.device("cpu")
+
+
+def check_default_alpha():
+    for sizes, repeats in (((10000,), (1,)), ((58000, 10000), (1, 1)), ((3, 5, 10), (2, 4, 1)), ((1,), (1,))):
+        sch = EntropySchedule(sizes, repeats)
+        for step in list(range(0, 400)) + list(range(57990, 58010)) + list(range(67990, 70010, 7)):
+            start, size = sch.position(step)
+            want = min(2.0 * (step - start) / size, 1.0)
+            alpha, update = sch(step)
+            assert alpha == want, (sizes, step, alpha, want)
+            assert update == (step > 0 and step == start + size - 1)
+        assert sch.ramp_len(10000) == 5000
+    print("schedule_ramp=0: α と差し替えの step は参照の式とビット単位で同じ")
+
+
+def check_ramp():
+    sch = EntropySchedule((2000,), (1,), ramp=250)
+    assert sch(4000) == (0.0, False) and sch(4125)[0] == 0.5 and sch(4250)[0] == 1.0 and sch(5999) == (1.0, True)
+    assert sch.ramp_len(2000) == 250
+    print("schedule_ramp=250: 段階の頭から 250 更新で α = 1")
+
+
+def check_monitors():
+    torch.manual_seed(0)
+    net = PolicyValueNet(8, 1)
+    learner = RNaDLearner(net, RNaDConfig(eta=0.2, beta=16.0, lr=1e-3, schedule_sizes=(4,), chunk=64), DEV,
+                          packed=True)
+    b = collect(tsuitate_rl.VecEnv(4, seed=3, auto_reset=False), learner.net, DEV, compact_legal=True)
+    info = learner.update(b)
+    for k in ("kl_online_reg", "kl_target_reg", "kl_online_target"):
+        assert info[k] == 0.0, (k, info[k])
+    for _ in range(5):
+        b = collect(tsuitate_rl.VecEnv(4, seed=3, auto_reset=False), learner.net, DEV, compact_legal=True)
+        info = learner.update(b)
+    vals = [info[k] for k in ("kl_online_reg", "kl_target_reg", "kl_online_target")]
+    assert all(torch.isfinite(torch.tensor(v)) and v > -1e-6 for v in vals) and vals[2] > 0, vals
+    print("見張り: 学習の頭は 0、更新後は " + " / ".join(f"{v:.2e}" for v in vals))
+
+
+def check_cfg_compat():
+    old = {k: v for k, v in RNaDConfig().__dict__.items() if k != "schedule_ramp"}
+    assert cfg_diff(old, RNaDConfig()) == {}
+    assert cfg_diff(old, RNaDConfig(schedule_ramp=250)) == {"schedule_ramp": (0, 250)}
+    print("schedule_ramp の無い古い checkpoint の設定とは差にならない")
+
+
+if __name__ == "__main__":
+    check_default_alpha()
+    check_ramp()
+    check_monitors()
+    check_cfg_compat()
